APP_NAME="SMAUII Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://smauii-core.test

# Host ports (docker compose)
APP_PORT=8800
PGSQL_PORT=5432
REDIS_PORT=6382
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# LOCAL DEVELOPMENT (PostgreSQL via Laragon)
# ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smauii_core
DB_USERNAME=postgres
DB_PASSWORD=
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_MAX_LIFETIME=3600

# ─────────────────────────────────────────────
# DEVELOPMENT (NeonDB) — uncomment & fill
# ─────────────────────────────────────────────
# DB_CONNECTION=pgsql
# DB_HOST=ep-damp-tooth-aoxkicmt-pooler.c-2.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_dev_password_here
# DB_SSLMODE=require

# ─────────────────────────────────────────────
# PREVIEW / STAGING (NeonDB) — uncomment & fill
# ─────────────────────────────────────────────
# DB_CONNECTION=pgsql
# DB_HOST=ep-steep-bonus-aocl59ol-pooler.c-2.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_preview_password_here
# DB_SSLMODE=require

# ─────────────────────────────────────────────
# PRODUCTION (NeonDB) — uncomment & fill
# ─────────────────────────────────────────────
# DB_CONNECTION=pgsql
# DB_HOST=your-production-host.neon.tech
# DB_PORT=5432
# DB_DATABASE=smauii_production
# DB_USERNAME=smauii_owner
# DB_PASSWORD=your_prod_password_here
# DB_SSLMODE=require

# ─────────────────────────────────────────────
# TESTING (SQLite in-memory)
# ─────────────────────────────────────────────
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Pusher Configuration (for real-time monitoring)
# Get your credentials from https://pusher.com
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────
# OBJECT STORAGE (S3 / RustFS / MinIO / Cloudflare R2 / AWS)
# ─────────────────────────────────────────────
FILESYSTEM_DISK=s3

# 1. Local Development & Preview Demo (RustFS — Native Lerd compatible, ultra lightweight):
AWS_ACCESS_KEY_ID=rustfs
AWS_SECRET_ACCESS_KEY=rustfs123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=smauii-attendance
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# 2. Alternative Local Development (MinIO):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=smauii-attendance
# AWS_ENDPOINT=http://minio:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true

# 3. Production Cloud (Cloudflare R2 or AWS S3):
# AWS_ACCESS_KEY_ID=your_production_s3_key
# AWS_SECRET_ACCESS_KEY=your_production_s3_secret
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=smauii-attendance-prod
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.smauiiyk.sch.id
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emails allowed to view Telescope in addition to admins
TELESCOPE_ALLOWED_EMAILS=
