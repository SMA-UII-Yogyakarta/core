APP_NAME="SMAUII Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://preview.smauiiyk.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=smauii_core
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─────────────────────────────────────────────
# OBJECT STORAGE (S3 / RustFS / Cloudflare R2 / AWS)
# ─────────────────────────────────────────────
FILESYSTEM_DISK=s3

# Preview / Demonstration (Self-hosted RustFS):
AWS_ACCESS_KEY_ID=rustfs
AWS_SECRET_ACCESS_KEY=rustfs123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=smauii-attendance
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Production Cloud Target (AWS S3 or Cloudflare R2):
# AWS_ACCESS_KEY_ID=your_production_s3_key
# AWS_SECRET_ACCESS_KEY=your_production_s3_secret
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=smauii-attendance-prod
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.smauiiyk.sch.id
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emails allowed to view Telescope in addition to admins
TELESCOPE_ALLOWED_EMAILS=
