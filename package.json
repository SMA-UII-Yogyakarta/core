{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "vite preview",
        "lint": "eslint ./resources/js/**/*.{ts,tsx}",
        "lint:fix": "eslint ./resources/js/**/*.{ts,tsx} --fix",
        "biome:check": "biome check ./resources/js",
        "biome:fix": "biome check --write ./resources/js",
        "format": "biome format --write ./resources/js",
        "typecheck": "tsc --noEmit",
        "types:generate": "php artisan typescript:transform",
        "test": "vitest run",
        "test:bun": "bun test resources/js/__tests__/schemas resources/js/__tests__/utils",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:a11y": "vitest run --reporter=verbose resources/js/__tests__/a11y.test.tsx",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "bun run test:bun && bun run test",
        "storybook": "storybook dev -p 6006 --ci --host 0.0.0.0",
        "build-storybook": "storybook build",
        "lhci": "lhci autorun",
        "lhci:collect": "lhci collect",
        "lhci:assert": "lhci assert"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@axe-core/react": "^4.12.1",
        "@biomejs/biome": "^2.5.8",
        "@eslint/js": "^10.0.1",
        "@inertiajs/react": "^2.3.27",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-a11y": "^8.6.14",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/blocks": "^8.6.14",
        "@storybook/react": "^8.6.14",
        "@storybook/react-vite": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/jest-axe": "^3.5.9",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "axe-core": "^4.12.1",
        "concurrently": "^9.2.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jest-axe": "^11.0.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.1.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "storybook": "^8.6.14",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vite-plugin-checker": "^0.14.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.4",
        "chart.js": "^4.5.1",
        "framer-motion": "^12.43.0",
        "laravel-echo": "^2.4.0",
        "pusher-js": "^8.6.0",
        "react-icons": "^5.7.0",
        "sonner": "^2.0.8",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "overrides": {
        "brace-expansion": "^5.0.9"
    }
}
