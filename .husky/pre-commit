#!/bin/sh

echo "🛡️  [DX Safety Guard] Running Pre-Commit Quality & Style Checks..."

# Check if SKIP_HOOKS or SKIP_COMMIT_HOOKS is set
if [ "$SKIP_HOOKS" = "1" ] || [ "$SKIP_COMMIT_HOOKS" = "1" ]; then
    echo "⚠️  [DX WARNING] Pre-commit checks are being SKIPPED by developer override!"
    
    DEV_NAME=$(git config user.name || echo "$USER")
    DEV_EMAIL=$(git config user.email || echo "unknown")
    TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
    
    if [ -z "$SKIP_REASON" ]; then
        echo "❌ [ERROR] Mandatory skip reason required! Please provide SKIP_REASON environment variable:"
        echo "   Example: SKIP_HOOKS=1 SKIP_REASON=\"Urgent hotfix for staging\" git commit -m \"...\""
        exit 1
    fi
    
    LOG_LINE="[$TIMESTAMP] DEVELOPER: $DEV_NAME ($DEV_EMAIL) | STAGE: PRE-COMMIT | REASON: \"$SKIP_REASON\""
    mkdir -p storage/logs
    echo "$LOG_LINE" >> storage/logs/git_skip_audit.log
    echo "📝 [AUDIT LOGGED] Skip reason recorded in storage/logs/git_skip_audit.log"
    echo "⚠️  Remember to run 'bun run typecheck', 'bun run test', and PHP tests after your commit!"
    exit 0
fi

# Run fast checks
echo "🔍 1/3 Checking TypeScript types..."
docker exec core-bun-1 bun run typecheck
if [ $? -ne 0 ]; then
    echo "❌ TypeScript typecheck failed! Fix errors before committing."
    exit 1
fi

echo "🎨 2/3 Checking Frontend ESLint..."
docker exec core-bun-1 bun run lint
if [ $? -ne 0 ]; then
    echo "❌ ESLint check failed! Run 'bun run lint:fix' to fix style issues."
    exit 1
fi

echo "🐘 3/3 Checking PHP Code Style (Laravel Pint)..."
docker exec core-app-1 ./vendor/bin/pint --test
if [ $? -ne 0 ]; then
    echo "❌ PHP Pint code style failed! Run 'docker exec core-app-1 ./vendor/bin/pint' to auto-fix code style."
    exit 1
fi

echo "✅ [DX Safety Guard] All pre-commit checks passed cleanly!"
